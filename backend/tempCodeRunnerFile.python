def longest_substring(s):
    longest = ""

    for i in range(len(s)):
        current = ""

        for j in range(i, len(s)):
            if s[j] not in current:
                current += s[j]
            else:
                break

        if len(current) > len(longest):
            longest = current

    return len(longest)

print(longest_substring("abcabcbb"))